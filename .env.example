# ─────────────────────────────────────────────────────────────
# WedLink environment template — copy to .env and fill real values.
# NEVER commit a real .env. These are placeholders only.
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ──
# Host ports are shifted to an uncommon range to avoid clashing with any
# existing local Postgres/Redis/MinIO. Containers still listen on standard
# ports internally; only the host-side mapping changed.
POSTGRES_USER=wedlink
POSTGRES_PASSWORD=wedlink_dev_password
POSTGRES_DB=wedlink
POSTGRES_PORT=55432
# Used by Prisma (apps/api)
DATABASE_URL=postgresql://wedlink:wedlink_dev_password@localhost:55432/wedlink?schema=public

# ── Redis (rate limiting / jobs) ──
REDIS_PORT=56379
REDIS_URL=redis://localhost:56379

# ── Object storage (S3-compatible; MinIO in dev) ──
S3_PORT=59000
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=wedlink-media
S3_ACCESS_KEY=wedlink_minio
S3_SECRET_KEY=wedlink_minio_dev_secret
MINIO_CONSOLE_PORT=59001

# ── API ──
API_PORT=4100
NODE_ENV=development
# Secrets below MUST be replaced with strong random values in any shared environment.
JWT_ACCESS_SECRET=replace_with_long_random_string_access
JWT_REFRESH_SECRET=replace_with_long_random_string_refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
COOKIE_DOMAIN=localhost
CORS_ORIGIN=http://localhost:3000

# ── Web (Next.js) ──
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4100

# ── Notification providers (OPTIONAL — leave blank to use labeled mock) ──
# When blank, the notification service runs in MOCK mode and does NOT send real messages.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER_API_KEY=
